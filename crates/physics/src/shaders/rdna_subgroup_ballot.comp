#version 450
#extension GL_EXT_scalar_block_layout: require
#extension GL_KHR_shader_subgroup_basic: require
#extension GL_KHR_shader_subgroup_vote: require
#extension GL_KHR_shader_subgroup_arithmetic: require

// =============================================================================
// RDNA Subgroup Ballot Broadphase -- O(N^2/W) via ballot
// =============================================================================
//
// For each body, use subgroup ballot to find all overlapping bodies
// within the same wave simultaneously. Each wave of 32 threads
// processes 32 bodies against each other.
//
// @location(0) readonly  buffer AABBs    { Vec4 a[]; } buf_aabb;
// @location(1) writeonly buffer Overlaps { uint o[]; } buf_overlaps;
// @location(2) readonly  buffer Counts   { uint n; }  buf_count;
//
// Push constants: body_count

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly  buffer buf_aabb    { vec4 a[]; };
layout(set = 0, binding = 1) writeonly buffer buf_overlaps { uint o[]; };
layout(set = 0, binding = 2) readonly  buffer buf_count   { uint n; };

layout(push_constant) uniform PushConstants {
    uint body_count;
    uint _pad[3];
};

uint atomInc(uint* p, uint val) {
    return atomicAdd(p, val);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint wave_id = gid / gl_WorkGroupSize.x;
    uint lane_id = gl_LocalInvocationID.x & (gl_SubgroupSize - 1);
    uint wave_start = wave_id * gl_WorkGroupSize.x;

    if (gid >= n) return;

    vec4 a = buf_aabb.a[gid];
    vec3 amin = vec3(a.x, a.y, a.z);
    vec3 amax = amin;

    // Check overlap with each body in this wave
    uint count = 0;
    for (uint i = 0u; i < gl_WorkGroupSize.x; i++) {
        uint j = wave_start + i;
        if (j >= n || j == gid) continue;

        vec4 b = buf_aabb.a[j];
        vec3 bmin = vec3(b.x, b.y, b.z);
        vec3 bmax = bmin;

        bool overlap = (amin.x <= bmax.x && bmin.x <= amax.x) &&
                       (amin.y <= bmax.y && bmin.y <= amax.y) &&
                       (amin.z <= bmax.z && bmin.z <= amax.z);

        if (overlap) {
            uint idx = atomInc(&buf_overlaps.o[0], 1u);
            buf_overlaps.o[idx * 2u + 1u] = gid;
            buf_overlaps.o[idx * 2u] = j;
            count++;
        }
    }
}
