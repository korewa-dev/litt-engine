#version 450
#extension GL_EXT_scalar_block_layout: require

// =============================================================================
// RDNA BVH Reuse -- Detect whether bounds changed, skip rebuild
// =============================================================================
//
// Computes a hash of all AABB corners. If the hash matches the previous
// frame's hash, the BVH can be reused without rebuilding.
//
// @location(0) readonly  buffer AABBs    { Vec4 a[]; } buf_aabb;
// @location(1) writeonly buffer HashOut  { uint h; }  buf_hash;
// @location(2) readonly  buffer PrevHash { uint h; }  buf_prev;
// @location(3) writeonly buffer Reused   { uint r; }  buf_reused;
//
// Push constants: body_count

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly  buffer buf_aabb    { vec4 a[]; };
layout(set = 0, binding = 1) writeonly buffer buf_hash    { uint h; };
layout(set = 0, binding = 2) readonly  buffer buf_prev    { uint h; };
layout(set = 0, binding = 3) writeonly buffer buf_reused  { uint r; };

layout(push_constant) uniform PushConstants {
    uint body_count;
    uint _pad[3];
};

// Simple FNV-1a hash
uint fnv1a(uint h, uint v) {
    return (h * 16777619u) ^ v;
}

uint hash_vec3(vec3 v) {
    uint h = 2166136261u;
    h = fnv1a(h, uint(v.x * 1000.0));
    h = fnv1a(h, uint(v.y * 1000.0));
    h = fnv1a(h, uint(v.z * 1000.0));
    return h;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= body_count) {
        // All threads done -- compute final hash
        return;
    }

    vec4 a = buf_aabb.a[gid];
    vec3 min = vec3(a.x, a.y, a.z);
    vec3 max = vec3(a.x, a.y, a.z); // placeholder, real max in w

    uint h = hash_vec3(min) ^ hash_vec3(max);

    // Reduce within wave using subgroup XOR
    h = h ^ subgroupShuffleXor(h, 16);
    h = h ^ subgroupShuffleXor(h, 8);
    h = h ^ subgroupShuffleXor(h, 4);
    h = h ^ subgroupShuffleXor(h, 2);
    h = h ^ subgroupShuffleXor(h, 1);

    // Thread 0 of each wave writes partial result
    if (gl_LocalInvocationID.x < 16) {
        // Write to scratch -- simplified: just use atomic
        // In a real implementation, use an atomic accumulation buffer
    }

    // Final: thread 0 of group 0 writes the hash
    if (gid == 0u) {
        // Compute a global hash by XORing all partial results
        // For simplicity, use the first thread's result as a proxy
        // A proper implementation would use a parallel reduction
        buf_hash.h = h;
        buf_reused.r = (h == buf_prev.h) ? 1u : 0u;
    }
}
