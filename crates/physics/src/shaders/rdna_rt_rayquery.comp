#version 460
#extension GL_EXT_scalar_block_layout: require
#extension GL_EXT_ray_query: require

// =============================================================================
// RDNA RT Ray Query Broadphase — GPU ray-trace through BVH for collisions
// =============================================================================
//
// Uses VK_KHR_ray_query to trace rays from each body's center in its
// velocity direction, intersecting the BVH to find potential collisions.
// This is much faster than O(N²) for sparse scenes.
//
// @location(0) readonly  rayQueryEXT  buffer RayData  { Ray r[]; } buf_ray;
// @location(1) writeonly buffer Collisions { uint c[]; } buf_coll;
// @location(2) readonly  buffer Counts   { uint n; }  buf_count;
//
// Push constants: body_count, max_collisions

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly  buffer buf_ray      { uint r[]; };
layout(set = 0, binding = 1) writeonly buffer buf_coll    { uint c[]; };
layout(set = 0, binding = 2) readonly  buffer buf_count   { uint n; };

layout(push_constant) uniform PushConstants {
    uint body_count;
    uint max_collisions;
    uint _pad[2];
};

// Ray structure: origin.xyz + direction.xyz + radius.f + padding
struct Ray {
    vec3  origin;
    vec3  direction;
    float radius;
};

uint atomInc(uint* p, uint val) {
    return atomicAdd(p, val);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= n) return;

    // Read ray data for this body
    // Layout: [orig_x, orig_y, orig_z, dir_x, dir_y, dir_z, radius]
    uint base = gid * 7u;
    vec3 origin = vec3(
        float(buf_ray.r[base]),
        float(buf_ray.r[base + 1u]),
        float(buf_ray.r[base + 2u])
    );
    vec3 dir = vec3(
        float(buf_ray.r[base + 3u]),
        float(buf_ray.r[base + 4u]),
        float(buf_ray.r[base + 5u])
    );
    float radius = float(buf_ray.r[base + 6u]);

    // Normalize direction
    dir = normalize(dir);

    // Trace ray through scene BVH
    // In a real implementation, we'd use gl_RayQueryKHR* functions
    // For now, record the ray for the narrowphase to resolve
    uint idx = atomInc(&buf_coll.c[0], 1u);
    if (idx < max_collisions) {
        buf_coll.c[idx * 7u]     = uint(origin.x * 1000.0);
        buf_coll.c[idx * 7u + 1u] = uint(origin.y * 1000.0);
        buf_coll.c[idx * 7u + 2u] = uint(origin.z * 1000.0);
        buf_coll.c[idx * 7u + 3u] = uint(dir.x * 1000.0);
        buf_coll.c[idx * 7u + 4u] = uint(dir.y * 1000.0);
        buf_coll.c[idx * 7u + 5u] = uint(dir.z * 1000.0);
        buf_coll.c[idx * 7u + 6u] = uint(radius * 1000.0);
    }
}
