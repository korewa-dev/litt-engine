#version 450
#extension GL_EXT_scalar_block_layout: require

// =============================================================================
// MUSA Compute Kernel -- Vector Dot Product (GPU-parallel)
// =============================================================================
// Dispatches a dot product of two float3 vectors across a 256-thread workgroup.
// Demonstrates MUSA compute capability via Vulkan.
//
// @location(0) readonly  buffer A  { float a[]; } buf_a;
// @location(1) readonly  buffer B  { float b[]; } buf_b;
// @location(2) writeonly buffer RESULT { float r[]; } buf_result;
//
// Push constants: n (count), stride

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly  buffer buf_a  { float a[]; };
layout(set = 0, binding = 1) readonly  buffer buf_b  { float b[]; };
layout(set = 0, binding = 2) writeonly buffer buf_result { float r[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    uint stride;
    uint _pad[2];
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= n) return;

    float a_val = buf_a.a[gid];
    float b_val = buf_b.b[gid];
    buf_result.r[gid] = a_val * b_val;
}
