#version 450
#extension GL_EXT_scalar_block_layout: require

// =============================================================================
// Litt Engine — Display / Copy Shader (Phase 12)
// =============================================================================
// Copies the accumulation buffer (R32G32B32A32_SFLOAT) to a swapchain image
// (typically B8G8R8A8_UNORM or R8G8B8A8_UNORM) with basic tone mapping.
//
// Layout:
//   @location(0)  readonly  image2D  accumulation;
//   @location(1)  writeonly image2D  swapchain_image;
//
// Push constants: resolution_x, resolution_y

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly  image2D accumulation;
layout(set = 0, binding = 1) writeonly image2D swapchain_image;

layout(push_constant) uniform PushConstants {
    uint resolution_x;
    uint resolution_y;
    uint _pad[2];
};

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= ivec2(resolution_x, resolution_y).xy) return;

    // Read accumulated HDR color
    vec4 hdr = imageLoad(accumulation, px);

    // Basic Reinhard tone mapping
    vec3 rgb = hdr.rgb;
    vec3 mapped = rgb / (1.0 + rgb);

    // Gamma correction
    mapped = pow(mapped, vec3(1.0 / 2.2));

    // Clamp to [0, 1] and write to swapchain
    imageStore(swapchain_image, px, vec4(clamp(mapped, 0.0, 1.0), 1.0));
}
