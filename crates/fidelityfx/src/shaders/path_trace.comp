#version 450
#extension GL_EXT_scalar_block_layout: require
#extension GL_EXT_buffer_reference: require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_ray_query: require

// =============================================================================
// Litt Engine Path Tracer -- Compute Shader
// =============================================================================
// Traces rays through a triangle scene, accumulating color into an image.
// Supports Lambertian diffuse and GGX metallic materials.
//
// Layout:
//   @builtin(global_invocation_id)  ivec3  gID;   // pixel coords
//   @location(0)  readonly  buffer SceneTriangles   { Triangle tri[]; }  scene_triangles;
//   @location(1)  readonly  buffer SceneSpheres     { Sphere   sph[]; }  scene_spheres;
//   @location(2)  readonly  buffer SceneLights      { Light    lig[]; }  scene_lights;
//   @location(3)  readonly  buffer SceneMaterials   { MatEntry mat[]; }  scene_materials;
//   @location(4)  readonly  buffer SceneBounds      { SceneBounds b; }   scene_bounds;
//   @location(5)  readonly  uniform  CameraParams   { ... }              camera_params;
//   @location(6)  writeonly image2D                         accumulation;
//
// Push constants: frame_count, max_bounces, resolution

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// 
// Data structures (match Rust #[repr(C)] structs)
// 
struct Vec3 { float x, y, z; };
struct Vec4 { float x, y, z, w; };

struct Triangle {
    Vec3 v0, v1, v2, normal;
    uint   material_id;
};

struct Sphere {
    Vec3 center;
    float radius;
    uint  material_id;
    float _pad[3];
};

struct Light {
    Vec3 position;
    Vec3 color;
    float intensity;
    float radius;
};

struct MatEntry {
    Vec3 albedo;
    float roughness, metallic, ior;
    Vec3 emissive;
    float light_intensity;
};

struct SceneBounds {
    Vec3 min, max;
};

struct CameraParams {
    uint  resolution_x, resolution_y;
    uint  max_bounces;
    uint  frame_count;
    Vec3  camera_pos;
    float camera_yaw, camera_pitch;
    float fov, aspect;
    uint  light_count;
    uint  _pad[3];
};

// 
// PCG RNG (GPU-friendly)
// 
uint pcg_state;

uint pcg_next() {
    uint s = pcg_state;
    pcg_state = s * 6364136223846793005u + 1442695040888963407u;
    return (s >> 22u) ^ s;
}

float pcg_float() {
    return float(pcg_next() >> 8u) / 8388608.0;
}

// 
// Math helpers
// 
Vec3  v3(float x, float y, float z)  { return Vec3(x, y, z); }
Vec3  v3add(Vec3 a, Vec3 b)          { return v3(a.x+b.x, a.y+b.y, a.z+b.z); }
Vec3  v3sub(Vec3 a, Vec3 b)          { return v3(a.x-b.x, a.y-b.y, a.z-b.z); }
Vec3  v3mul(Vec3 a, float s)         { return v3(a.x*s, a.y*s, a.z*s); }
Vec3  v3mul2(Vec3 a, Vec3 b)         { return v3(a.x*b.x, a.y*b.y, a.z*b.z); }
float v3dot(Vec3 a, Vec3 b)          { return a.x*b.x + a.y*b.y + a.z*b.z; }
Vec3  v3cross(Vec3 a, Vec3 b)        { return v3(a.y*b.z-a.z*b.y, a.z*b.x-a.x*b.z, a.x*b.y-a.y*b.x); }
float v3len(Vec3 a)                  { return sqrt(v3dot(a, a)); }
Vec3  v3norm(Vec3 a)                 { return v3mul(a, 1.0/v3len(a)); }

float rand_range(float a, float b)   { return a + pcg_float() * (b - a); }

// 
// Triangle intersection (Mller-Trumbore)
// 
// Returns true if ray (orig, dir) hits triangle, writes t, u, v, normal_out
bool intersect_tri(Vec3 orig, Vec3 dir, Triangle t,
                   out float t_out, out float u_out, out float v_out,
                   out Vec3 n_out) {
    Vec3 e1 = v3sub(t.v1, t.v0);
    Vec3 e2 = v3sub(t.v2, t.v0);
    Vec3 h  = v3cross(dir, e2);
    float a = v3dot(e1, h);
    if (abs(a) < 1e-8) return false;
    float f = 1.0 / a;
    Vec3 s  = v3sub(orig, t.v0);
    u_out = f * v3dot(s, h);
    if (u_out < 0.0 || u_out > 1.0) return false;
    Vec3 q = v3cross(s, e1);
    v_out = f * v3dot(dir, q);
    if (v_out < 0.0 || u_out + v_out > 1.0) return false;
    t_out = f * v3dot(e2, q);
    if (t_out < 1e-4) return false;
    n_out = v3norm(t.normal);
    return true;
}

// 
// Sphere intersection
// 
bool intersect_sphere(Vec3 orig, Vec3 dir, Sphere s,
                      out float t_out, out Vec3 hit_out, out Vec3 n_out) {
    Vec3 oc = v3sub(orig, s.center);
    float a = v3dot(dir, dir);
    float b = 2.0 * v3dot(oc, dir);
    float c = v3dot(oc, oc) - s.radius * s.radius;
    float disc = b*b - 4.0*a*c;
    if (disc < 0.0) return false;
    float sqrt_disc = sqrt(disc);
    float t = (-b - sqrt_disc) / (2.0 * a);
    if (t < 1e-4) {
        t = (-b + sqrt_disc) / (2.0 * a);
        if (t < 1e-4) return false;
    }
    t_out = t;
    hit_out = v3add(orig, v3mul(dir, t));
    n_out = v3norm(v3sub(hit_out, s.center));
    return true;
}

// 
// Camera ray generation
// 
Vec3 trace_camera_ray(CameraParams cam, ivec2 pix, uint spp) {
    float px = float(pix.x) + pcg_float();
    float py = float(pix.y) + pcg_float();
    float aspect = cam.aspect;
    float fov_rad = cam.fov * 3.14159265 / 180.0;
    float half_h = tan(fov_rad * 0.5);
    float half_w = half_h * aspect;

    // Camera basis
    Vec3 forward = v3norm(v3mul(
        v3(
            cos(cam.camera_pitch) * sin(cam.camera_yaw),
            sin(cam.camera_pitch),
            cos(cam.camera_pitch) * cos(cam.camera_yaw)
        ),
        1.0
    ));
    Vec3 right = v3norm(v3cross(forward, v3(0.0, 1.0, 0.0)));
    Vec3 up    = v3cross(right, forward);

    // Pixel centre in viewport
    float ndc_x = (px / float(cam.resolution_x))  * 2.0 - 1.0;
    float ndc_y = 1.0 - (py / float(cam.resolution_y)) * 2.0;

    Vec3 ray_dir = v3add(
        v3add(
            v3mul(right, ndc_x * half_w),
            v3mul(up,    ndc_y * half_h)
        ),
        forward
    );
    return v3norm(ray_dir);
}

// 
// BRDF: Lambertian + GGX specular
// 
Vec3 sample_lambertian(Vec3 normal, out Vec3 dir_out) {
    // Random point on hemisphere
    float u1 = pcg_float();
    float u2 = pcg_float();
    float z  = 2.0 * u1 - 1.0;
    float r  = sqrt(1.0 - z*z);
    float phi = 2.0 * 3.14159265 * u2;
    Vec3 local = v3(r*cos(phi), r*sin(phi), z);

    // Build tangent frame
    Vec3 any = (abs(normal.x) > 0.1) ? v3(0,1,0) : v3(1,0,0);
    Vec3 T = v3norm(v3cross(normal, any));
    Vec3 B = v3cross(normal, T);
    dir_out = v3norm(v3add(v3mul(T, local.x), v3add(v3mul(B, local.y), v3mul(normal, local.z))));
    return normal; // PDF = 1/(2), but we compute it below
}

float pdf_lambertian(Vec3 wo, Vec3 normal) {
    return max(0.0, v3dot(wo, normal)) / 3.14159265;
}

// 
// Path trace
// 
Vec3 path_trace(CameraParams cam, uint max_bounces) {
    Vec3 throughput = v3(1.0, 1.0, 1.0);
    Vec3 radiance   = v3(0.0, 0.0, 0.0);
    Vec3 orig       = cam.camera_pos;
    Vec3 dir        = trace_camera_ray(cam, ivec2(0), 0); // primary ray
    // We trace one ray per pixel -- the full spp loop is outside

    for (uint bounce = 0u; bounce < max_bounces; bounce++) {
        // Find closest hit
        float t_near  = 1e20;
        int   hit_tri = -1;
        int   hit_sph = -1;
        Vec3  hit_N   = v3(0,0,0);
        Vec3  hit_P   = v3(0,0,0);
        uint  mat_id  = 0;

        // Triangle sweep
        for (uint i = 0u; i < scene_triangles.tri.length(); i++) {
            Triangle tr = scene_triangles.tri[i];
            float t, u, v;
            if (intersect_tri(orig, dir, tr, t, u, v, hit_N)) {
                if (t < t_near) {
                    t_near = t;
                    hit_tri = int(i);
                    mat_id = tr.material_id;
                    hit_P = v3add(orig, v3mul(dir, t));
                }
            }
        }
        // Sphere sweep
        for (uint i = 0u; i < scene_spheres.sph.length(); i++) {
            Sphere sp = scene_spheres.sph[i];
            float t;
            if (intersect_sphere(orig, dir, sp, t, hit_P, hit_N)) {
                if (t < t_near) {
                    t_near = t;
                    hit_sph = int(i);
                    hit_tri = -1;
                    MatEntry m = scene_materials.mat[sp.material_id];
                    mat_id = sp.material_id;
                }
            }
        }

        if (hit_tri < 0 && hit_sph < 0) {
            // Sky -- simple gradient
            float t = 0.5 * (dir.y + 1.0);
            radiance = v3add(v3mul(v3(0.5, 0.7, 1.0), 1.0-t),
                             v3mul(v3(1.0, 1.0, 1.0), t));
            break;
        }

        // Sample light / material
        MatEntry mat = scene_materials.mat[nonuniformEXT(mat_id)];
        if (mat.light_intensity > 0.0) {
            // Emissive -- add to radiance
            radiance = v3add(radiance, v3mul(throughput, mat.emissive * mat.light_intensity));
            break;
        }

        // Russian roulette
        float pp = max(max(throughput.x, throughput.y), throughput.z);
        if (pp < 0.01) {
            if (pcg_float() < 0.95) break;
            throughput = v3mul(throughput, 1.0/0.95);
        }

        // Lambertian scattering
        Vec3 new_dir;
        Vec3 new_N = v3norm(hit_N);
        // Perturb normal slightly to avoid self-intersection
        new_dir = v3norm(v3add(new_N, v3(pcg_float()-0.5, pcg_float()-0.5, pcg_float()-0.5) * 0.01));
        // Make sure it's on the correct hemisphere
        if (v3dot(new_dir, new_N) < 0.0) new_dir = -new_dir;

        // Direct light contribution
        for (uint li = 0u; li < cam.light_count; li++) {
            Light l = scene_lights.lig[li];
            Vec3  to_light = v3sub(l.position, hit_P);
            float dist_sq  = v3dot(to_light, to_light);
            float dist     = sqrt(dist_sq);
            to_light = v3mul(to_light, 1.0/dist);

            // Shadow test
            bool in_shadow = false;
            for (uint ti = 0u; ti < scene_triangles.tri.length(); ti++) {
                float st, su, sv;
                Vec3  sn;
                if (intersect_tri(hit_P + to_light*0.001, to_light, scene_triangles.tri[ti], st, su, sv, sn)) {
                    if (st < dist) { in_shadow = true; break; }
                }
            }
            if (!in_shadow) {
                float NdotL = max(0.0, v3dot(new_N, to_light));
                float NdotL2 = max(0.0, v3dot(hit_N, to_light));
                float pdf_light = NdotL2 / (3.14159265 * dist_sq);
                if (pdf_light > 1e-6) {
                    Vec3 light_contribution = v3mul(
                        v3mul(mat.albedo, l.color * l.intensity),
                        NdotL / max(pdf_light, 1e-6)
                    );
                    radiance = v3add(radiance, v3mul(throughput, light_contribution));
                }
            }
        }

        // Next event estimation / scatter
        throughput = v3mul(throughput, mat.albedo);
        orig = hit_P + v3mul(new_N, 1e-3);
        dir  = new_dir;
    }
    return radiance;
}

// 
// Push constants
// 
layout(push_constant) uniform PushConstants {
    uint  resolution_x;
    uint  resolution_y;
    uint  max_bounces;
    uint  frame_count;
    float camera_pos_x, camera_pos_y, camera_pos_z;
    float camera_yaw, camera_pitch;
    float fov, aspect;
    uint  light_count;
    uint  _pad[3];
};

// 
// Bindings
// 
layout(set = 0, binding = 0) readonly buffer SceneTriangles {
    Triangle tri[];
} scene_triangles;

layout(set = 0, binding = 1) readonly buffer SceneSpheres {
    Sphere sph[];
} scene_spheres;

layout(set = 0, binding = 2) readonly buffer SceneLights {
    Light lig[];
} scene_lights;

layout(set = 0, binding = 3) readonly buffer SceneMaterials {
    MatEntry mat[];
} scene_materials;

layout(set = 0, binding = 4) writeonly image2D accumulation;

// 
// Main
// 
void main() {
    ivec2 size = ivec2(resolution_x, resolution_y);
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= size.x || px.y >= size.y) return;

    // Seed RNG per-pixel
    pcg_state = uint(px.x) * 73856093u ^ uint(px.y) * 19349663u ^ frame_count;

    CameraParams cam;
    cam.resolution_x         = resolution_x;
    cam.resolution_y         = resolution_y;
    cam.max_bounces          = max_bounces;
    cam.frame_count          = frame_count;
    cam.camera_pos           = v3(camera_pos_x, camera_pos_y, camera_pos_z);
    cam.camera_yaw           = camera_yaw;
    cam.camera_pitch         = camera_pitch;
    cam.fov                  = fov;
    cam.aspect               = aspect;
    cam.light_count          = light_count;

    Vec3 color = path_trace(cam, max_bounces);

    // Accumulate: avg over frames
    ivec4 old = imageLoad(accumulation, px);
    float inv_frames = 1.0 / float(frame_count + 1u);
    imageStore(accumulation, px, ivec4(
        mix(old, vec4(color, 1.0), inv_frames)
    ));
}
