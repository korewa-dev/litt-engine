#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// FSR 3.1.5 Upscaler — AMD FidelityFX Super Resolution 3 Spatial Pass
// Inputs:  low-res path-traced image, motion history, velocity field
// Output:  high-res sharpened image with temporal stabilization

layout(set = 0, binding = 0) uniform sampler2D sInput;
layout(set = 0, binding = 1) uniform sampler2D sHistory;
layout(set = 0, binding = 2) uniform usampler2D sVelocity;
layout(set = 0, binding = 3) writeonly uniform image2D imgOutput;

layout(push_constant) uniform Push {
    uint inputSizeX;
    uint inputSizeY;
    uint outputSizeX;
    uint outputSizeY;
    float sharpeness;
    float contrast;
    float alpha;      // temporal blend weight
    float beta;       // spatial blend weight
} PC;

void main() {
    ivec2 dstPx  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = ivec2(PC.outputSizeX, PC.outputSizeY);
    ivec2 srcSize = ivec2(PC.inputSizeX, PC.inputSizeY);

    // UV coordinates for input (low-res) and output (high-res)
    vec2 srcUv = vec2(dstPx) * vec2(float(srcSize)) / vec2(float(dstSize));
    vec2 dstUv = vec2(dstPx) / vec2(float(dstSize));

    // Sample velocity from low-res texture
    vec4 velRaw = vec4(texelFetch(sVelocity, dstPx, 0));
    vec2 vel = (velRaw.xy / 65535.0) * 2.0 - 1.0;

    // Reproject history
    vec2 historyUv = dstUv - vel * 0.5;
    historyUv = clamp(historyUv, vec2(0.0), vec2(1.0) - 1.0 / vec2(float(dstSize)));

    // Sample current and history
    vec4 current = texture(sInput, srcUv / vec2(float(srcSize)));
    vec4 history = texture(sHistory, historyUv);

    // Temporal blend
    vec4 result = mix(current, history, PC.alpha);

    // Contrast adjustment
    result.rgb = (result.rgb - 0.5) * PC.contrast + 0.5;

    // Sharpening (unsharp mask)
    float sharp = PC.sharpness;
    if (sharp > 0.0 && sharp < 1.0) {
        vec2 px = 1.0 / vec2(float(srcSize));
        vec3 center = result.rgb;
        vec3 left   = texture(sInput, (srcUv - vec2(px.x, 0.0)) / vec2(float(srcSize))).rgb;
        vec3 right  = texture(sInput, (srcUv + vec2(px.x, 0.0)) / vec2(float(srcSize))).rgb;
        vec3 up     = texture(sInput, (srcUv - vec2(0.0, px.y)) / vec2(float(srcSize))).rgb;
        vec3 down   = texture(sInput, (srcUv + vec2(0.0, px.y)) / vec2(float(srcSize))).rgb;
        vec3 laplacian = center - (left + right + up + down) * 0.25;
        result.rgb = center + laplacian * sharp;
    }

    imageStore(imgOutput, dstPx, clamp(result, 0.0, 1.0));
}
