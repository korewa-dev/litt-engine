            e.damage = 60.0f; e.speed = 2.0f; e.aggroRange = 20.0f;
            e.attackRange = 5.0f; e.attackCooldown = 2.0f;
            e.soulsReward = 3500; e.dropChance = 100; e.isBoss = true; e.reset();
