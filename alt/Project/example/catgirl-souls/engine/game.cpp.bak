        a.skyColor = 0x222233; a.fogColor = 0x333344; a.fogDensity = 0.012f;
        a.requiredSouls = 500;
        Bonfire b1; strcpy(b1.name, "Keep Gate"); b1.position = Vec3(200, 0, 0);
        b1.area = AreaID::CRUMBLING_KEEP; a.bonfires.push_back(b1);
