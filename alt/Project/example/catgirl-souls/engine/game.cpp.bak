    // Area 3: Frozen Depths
    {
        AreaData& a = g.areas[3];
        a.id = AreaID::FROZEN_DEPTHS; strcpy(a.name, "Frozen Depths");
        a.worldOffset = Vec3(300, 0, 0); a.dangerLevel = 4.0f;
