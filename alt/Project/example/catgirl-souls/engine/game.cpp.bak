        a.requiredSouls = 1000;
        Bonfire b1; strcpy(b1.name, "Frozen Shore"); b1.position = Vec3(300, 0, 0);
        b1.area = AreaID::FROZEN_DEPTHS; a.bonfires.push_back(b1);
        for (int i = 0; i < 15; i++) {
            Enemy e; sprintf(e.name, "Frost Wolf %d", i+1);
